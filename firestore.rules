rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public content & products: live access for admin and users
    match /products/{productId} {
      allow read, write: if true;
    }

    match /site_content/{contentId} {
      allow read, write: if true;
    }

    // Customer user profiles & addresses
    match /users/{userId} {
      allow read, write: if true;
      
      match /addresses/{addressId} {
        allow read, write: if true;
      }
    }

    // Admin profiles
    match /admins/{userId} {
      allow read, write: if true;
    }

    // Orders: allow customers to place and admins to view/manage
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}

